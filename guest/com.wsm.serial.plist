<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.wsm.serial</string>
	<key>ProgramArguments</key><array><string>/bin/sh</string><string>/usr/local/libexec/wsm-serial.sh</string></array>
	<key>KeepAlive</key><true/>
	<key>StandardInPath</key><string>/dev/console</string>
	<key>StandardOutPath</key><string>/dev/console</string>
	<key>StandardErrorPath</key><string>/dev/console</string>
	<key>ThrottleInterval</key><integer>2</integer>
	<key>RunAtLoad</key><true/>
</dict>
</plist>
